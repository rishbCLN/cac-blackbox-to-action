# CAC configuration.  Copy to `.env` and edit; every variable is optional.
# `.env` is git-ignored — never commit real keys.

# ---------------------------------------------------------------- pipeline
CAC_RANDOM_STATE=42
CAC_LOG_LEVEL=INFO
CAC_N_COUNTERFACTUALS=5
CAC_N_QUERY_INSTANCES=100

# ------------------------------------------------------- optional LLM layer
# The whole pipeline runs with USE_LLM=false and needs no key at all.
# Set to true and inject a key only if you want natural-language rewrites of
# the generated action plans (src/methods/cac.py -> explain_in_words).
CAC_USE_LLM=false
CAC_LLM_PROVIDER=anthropic
CAC_LLM_MODEL=claude-opus-5
CAC_LLM_API_KEY=
