data/processed/*_metadata.json
models/*.joblib
models/metrics.json
results/
paper/figures/*.png
paper/figures/*.pdf
paper/tables/*.tex

# keep the hand-written SCMs and directory placeholders
!data/scm/*.json
!.gitkeep

